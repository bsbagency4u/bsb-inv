# BSB StockFlow — environment variables
#
# Copy this file to .env.local and fill in your Supabase project values.
# Without these the app runs in local demo mode (data stays in the browser).

# Public Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (SERVER ONLY — never expose to the browser).
# Used for privileged server-side operations. Can be left empty for Phase 1.
SUPABASE_SERVICE_ROLE_KEY=
